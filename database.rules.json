{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName','createdAt']) && (!data.child('phone').exists() || newData.child('phone').val() === data.child('phone').val())",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[1-9][0-9]{9}$/) && (!data.exists() || data.val() === newData.val()) && root.child('phoneIndex').child(newData.val()).val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "phoneIndex": {
      ".read": false,
      "$number": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$number.matches(/^[1-9][0-9]{9}$/) && newData.isString()"
      }
    },
    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$number": {
          ".validate": "$number.matches(/^[1-9][0-9]{9}$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        }
      }
    },
    "cleared": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$cid": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$cid": {
          ".write": "auth != null && (auth.uid === $uid || (root.child('conversations').child($cid).child('members').child(auth.uid).val() === true && root.child('conversations').child($cid).child('members').child($uid).val() === true))",
          "type": {
            ".validate": "newData.val() === 'direct' || newData.val() === 'group'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "members": {
            "$m": {
              ".validate": "newData.val() === true"
            }
          },
          "admins": {
            "$m": {
              ".validate": "newData.val() === true"
            }
          },
          "last": {
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "senderId": {
              ".validate": "newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "unread": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "conversations": {
      "$cid": {
        ".read": "root.child('conversations').child($cid).child('members').child(auth.uid).val() === true",
        "meta": {
          ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid",
          ".validate": "newData.hasChildren(['type','createdBy','createdAt'])",
          "type": {
            ".validate": "newData.val() === 'direct' || newData.val() === 'group'"
          },
          "createdBy": {
            ".validate": "newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "name": {
            ".write": "auth != null && root.child('conversations').child($cid).child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$m": {
            ".read": "auth != null && auth.uid === $m",
            ".write": "auth != null && ((auth.uid === $m && data.exists() && !newData.exists()) || (root.child('conversations').child($cid).child('admins').child(auth.uid).val() === true && !data.exists() && newData.val() === true) || (root.child('conversations').child($cid).child('meta').child('createdBy').val() === auth.uid && !root.child('conversations').child($cid).child('members').exists()))",
            ".validate": "newData.val() === true"
          }
        },
        "admins": {
          "$m": {
            ".write": "auth != null && ((auth.uid === $m && data.exists() && !newData.exists()) || (root.child('conversations').child($cid).child('meta').child('createdBy').val() === auth.uid && root.child('conversations').child($cid).child('meta').child('type').val() === 'group' && !root.child('conversations').child($cid).child('admins').exists() && $m === auth.uid))",
            ".validate": "newData.val() === true"
          }
        },
        "messages": {
          ".indexOn": [
            "createdAt"
          ],
          "$mid": {
            ".write": "auth != null && !data.exists() && newData.exists() && root.child('conversations').child($cid).child('members').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['senderId','senderName','kind','createdAt','readBy']) && newData.child('senderId').val() === auth.uid && newData.child('readBy').child(auth.uid).val() === true && ((newData.child('kind').val() === 'text' && newData.child('text').isString()) || (newData.child('kind').val() === 'gif' && newData.child('url').isString() && newData.child('url').val().matches(/^https:\\/\\/media[0-9]*\\.giphy\\.com\\/.*/)) || ((newData.child('kind').val() === 'image' || newData.child('kind').val() === 'video') && newData.child('url').isString() && newData.child('url').val().matches(/^https:\\/\\/files\\.catbox\\.moe\\/[A-Za-z0-9_-]+\\.[A-Za-z0-9]{2,5}$/)))",
            "senderId": {
              ".validate": "newData.isString()"
            },
            "senderName": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "kind": {
              ".validate": "newData.val() === 'text' || newData.val() === 'gif' || newData.val() === 'image' || newData.val() === 'video'"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000"
            },
            "url": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "createdAt": {
              ".validate": "newData.val() === now"
            },
            "readBy": {
              "$u": {
                ".write": "auth != null && auth.uid === $u && root.child('conversations').child($cid).child('members').child(auth.uid).val() === true",
                ".validate": "newData.val() === true"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "statuses": {
      "$sid": {
        ".read": "auth != null && (data.child('authorId').val() === auth.uid || data.child('viewers').child(auth.uid).val() === true) && data.child('expiresAt').val() > now",
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.child('authorId').val() === auth.uid && !newData.exists()))",
        ".validate": "newData.hasChildren(['authorId','authorName','text','createdAt','expiresAt','viewers']) && newData.child('authorId').val() === auth.uid",
        "authorId": {
          ".validate": "newData.isString()"
        },
        "authorName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 700"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now + 82800000 && newData.val() <= now + 90000000"
        },
        "viewers": {
          ".validate": "newData.val() === true"
          "$v": {
            ".validate": "newData.val() === true"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "statusFeed": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$sid": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (!data.exists() && root.child('statuses').child($sid).child('authorId').val() === auth.uid && (root.child('statuses').child($sid).child('viewers').child($uid).val() === true || $uid === auth.uid)))",
          "authorId": {
            ".validate": "newData.isString()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "expiresAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "statusViews": {
      "$sid": {
        ".read": "auth != null && root.child('statuses').child($sid).child('authorId').val() === auth.uid",
        ".write": "auth != null && root.child('statuses').child($sid).child('authorId').val() === auth.uid && !newData.exists()",
        "$viewer": {
          ".write": "auth != null && auth.uid === $viewer && root.child('statuses').child($sid).child('viewers').child(auth.uid).val() === true",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "callInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (!data.exists() && root.child('calls').child($callId).child('callerId').val() === auth.uid && root.child('calls').child($callId).child('calleeId').val() === $uid))",
          "callerId": {
            ".validate": "newData.isString()"
          },
          "conversationId": {
            ".validate": "newData.isString()"
          },
          "type": {
            ".validate": "newData.val() === 'voice' || newData.val() === 'video'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('callerId').val() === auth.uid && newData.child('state').val() === 'ringing' && root.child('conversations').child(newData.child('conversationId').val()).child('members').child(auth.uid).val() === true && root.child('conversations').child(newData.child('conversationId').val()).child('members').child(newData.child('calleeId').val()).val() === true",
        ".validate": "newData.hasChildren(['callerId','calleeId','conversationId','type','state','offer','createdAt'])",
        "callerId": {
          ".validate": "newData.isString()"
        },
        "calleeId": {
          ".validate": "newData.isString()"
        },
        "conversationId": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.val() === 'voice' || newData.val() === 'video'"
        },
        "state": {
          ".write": "auth != null && (data.parent().child('callerId').val() === auth.uid || data.parent().child('calleeId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().matches(/^(ringing|accepted|rejected|ended|missed)$/)"
        },
        "offer": {
          "type": {
            ".validate": "newData.isString()"
          },
          "sdp": {
            ".validate": "newData.isString() && newData.val().length < 30000"
          },
          "$other": {
            ".validate": false
          }
        },
        "answer": {
          ".write": "auth != null && data.parent().child('calleeId').val() === auth.uid",
          "type": {
            ".validate": "newData.isString()"
          },
          "sdp": {
            ".validate": "newData.isString() && newData.val().length < 30000"
          },
          "$other": {
            ".validate": false
          }
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "candidates": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid && (data.parent().parent().child('callerId').val() === auth.uid || data.parent().parent().child('calleeId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['from','candidate'])",
            "from": {
              ".validate": "newData.isString()"
            },
            "candidate": {
              ".validate": "newData.isString() && newData.val().length < 2000"
            },
            "sdpMid": {
              ".validate": "newData.isString()"
            },
            "sdpMLineIndex": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
